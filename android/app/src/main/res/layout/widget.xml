<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="#FF5B5BF7">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="iTeam"
        android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="16sp" />
    <TextView android:id="@+id/w_unread" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="14sp" android:layout_marginTop="6dp" android:text="No new messages" />
    <TextView android:id="@+id/w_task" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="2" android:layout_marginTop="4dp" android:text="No open tasks" />
</LinearLayout>
